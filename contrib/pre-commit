#!/bin/sh

container=`docker ps --format "{{.Names}}" --filter "name=simple-elasticsearch-php" | head -n 1`

if [ -z $container ]
    then
        echo "Your container name is not valid. Try put simple-elasticsearch-php on the end of container's name."
fi

echo "Checking PHP Lint in src..."
docker exec -w /var/www/html $container composer lint
if [ $? != 0 ]
then
    echo "Fix the PHP sintax errors before commit."
    exit 1
fi

echo "Running Code Sniffer..."
docker exec -w /var/www/html $container composer cs
if [ $? != 0 ]
then
    echo "Fix the Code Sniffers errors before commit."
    exit 1
fi

echo "Running PHP Stan..."
docker exec -w /var/www/html $container composer static
if [ $? != 0 ]
then
    echo "Fix the PHP Stan errors before commit."
    exit 1
fi

echo "Running Unit Tests..."
docker exec -w /var/www/html $container composer test
if [ $? != 0 ]
then
    echo "Fix the Unit Tests errors before commit."
    exit 1
fi

echo "Checking Unit Coverage..."
docker exec -w /var/www/html $container composer ccu

if [ $? != 0 ]
then
    echo "Raise the Unit Coverage to 100% before commit."
    exit 1
fi

exit $?